# Python 缓存和虚拟环境 / Python caches and virtualenv
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# 记下来的钥匙，跑起来才有，不该进版本库
# Remembered keys: created at runtime, should not be committed
.key_cache.json
.key_cache.json.tmp

# numba 的编译缓存 / numba's compilation cache
.numba_cache/

# 编辑器和系统的杂七杂八 / editor and system clutter
*.swp
*.swo
.idea/
.vscode/
.DS_Store
Thumbs.db

# 浏览器通道 / Discord 账号池
.browser_profile/
.profiles/
.discord_accounts.json
browser_debug/

# 上游门禁状态 / 自学习结果（字段名、sitekey、经验表）—— 运行时生成
.link_source_state.json
.link_source_state.json.*

# 失败重试队列（运行时生成）
.delta_retryq.json
.delta_retryq.json.*

# 本地/服务器配置，含 token 时绝不能进版本库
.env
delta.env
